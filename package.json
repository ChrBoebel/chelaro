{
  "name": "finance-os",
  "version": "0.5.2",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:api": "uv run --project apps/api pip-audit",
    "audit:web": "pnpm audit --audit-level high",
    "build:agent-host": "pnpm --filter @finance-os/agent-host build",
    "build:agent-storage": "pnpm --filter @finance-os/agent-storage build",
    "bootstrap:agent-tools": "node scripts/install-agent-tools.mjs",
    "check:safety": "bash scripts/check-repository-safety.sh",
    "check:version-bump": "node scripts/check-version-bump.mjs",
    "dev:api": "uv run --project apps/api uvicorn finance_os_api.main:app --app-dir apps/api/src --reload --host 127.0.0.1 --port 8000",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:web": "pnpm --filter web dev",
    "generate:codex-schema": "pnpm --filter @finance-os/agent-host generate:codex-schema",
    "generate:icons": "bash scripts/generate-app-icons.sh",
    "infra:config": "docker compose --env-file .env.example -f infra/docker/compose.yaml config --quiet",
    "infra:down": "docker compose --env-file .env -f infra/docker/compose.yaml down",
    "infra:up": "docker compose --env-file .env -f infra/docker/compose.yaml up -d --wait",
    "check:codex-schema": "pnpm --filter @finance-os/agent-host check:codex-schema",
    "check:codex-compat": "pnpm --filter @finance-os/agent-host check:codex-compat",
    "check:agent-tools": "node scripts/install-agent-tools.mjs --check",
    "lint:api": "uv run --project apps/api ruff check apps/api",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "migrate:api": "uv run --project apps/api alembic -c apps/api/alembic.ini upgrade head",
    "migrate:api:check": "uv run --project apps/api alembic -c apps/api/alembic.ini check",
    "package:desktop": "pnpm --filter desktop package:mac",
    "package:desktop:dir": "pnpm --filter desktop package:mac:dir",
    "prepare:desktop-runtime": "bash scripts/prepare-desktop-runtime.sh",
    "release:check": "bash scripts/check-release-readiness.sh",
    "smoke:web:standalone": "node scripts/smoke-standalone-web.mjs",
    "quality": "pnpm check:safety && pnpm quality:api && pnpm quality:web && pnpm quality:desktop && pnpm quality:agent",
    "quality:agent": "pnpm typecheck:agent-storage && pnpm test:agent-storage && pnpm typecheck:agent-host && pnpm check:codex-schema && pnpm check:codex-compat",
    "quality:agent:macos": "pnpm quality:agent && pnpm check:agent-tools && pnpm test:agent-host",
    "quality:api": "pnpm lint:api && pnpm typecheck:api && pnpm test:api && pnpm audit:api",
    "quality:desktop": "pnpm --filter desktop check",
    "quality:web": "pnpm lint:web && pnpm typecheck:web && pnpm test:web && pnpm build:web && pnpm audit:web",
    "start:api": "uv run --project apps/api uvicorn finance_os_api.main:app --app-dir apps/api/src --host 127.0.0.1 --port 8000",
    "start:web": "pnpm --filter web start",
    "typecheck:api": "uv run --project apps/api mypy apps/api/src apps/api/tests",
    "typecheck:agent-host": "pnpm --filter @finance-os/agent-host typecheck",
    "typecheck:agent-storage": "pnpm --filter @finance-os/agent-storage typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "test:api": "uv run --project apps/api pytest apps/api/tests",
    "test:agent-host": "pnpm --filter @finance-os/agent-host test",
    "test:agent-host:contract": "pnpm --filter @finance-os/agent-host test -- --test-name-pattern=contract",
    "test:agent-host:isolation": "pnpm --filter @finance-os/agent-host test:isolation",
    "test:agent-storage": "pnpm --filter @finance-os/agent-storage test",
    "test:desktop": "pnpm --filter desktop test",
    "test:e2e:finance-assistant": "pnpm --filter desktop e2e:finance-assistant",
    "test:e2e:update-flow": "pnpm --filter desktop e2e:update-flow",
    "test:web": "pnpm --filter web test"
  }
}
