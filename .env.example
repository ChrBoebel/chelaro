# Copy to .env for local development. Never commit real credentials.
FINANCE_OS_ENV=development
FINANCE_OS_API_HOST=127.0.0.1
FINANCE_OS_API_PORT=8000
FINANCE_OS_WEB_ORIGIN=http://localhost:3000
FINANCE_OS_API_TOKEN=replace-with-a-local-random-token
FINANCE_OS_AGENT_TOKEN=replace-with-a-different-agent-token
FINANCE_OS_FINANCE_ASSISTANT_TOKEN=replace-with-a-third-local-random-token
FINANCE_OS_POSTGRES_DB=finance_os
FINANCE_OS_POSTGRES_USER=finance_os
FINANCE_OS_POSTGRES_PASSWORD=replace-with-a-local-random-value
FINANCE_OS_DATABASE_URL=postgresql+asyncpg://finance_os:replace-with-a-local-random-value@localhost:5432/finance_os
FINANCE_OS_STORAGE_DRIVER=filesystem
FINANCE_OS_DOCUMENT_ROOT=./data/documents
FINANCE_OS_QUARANTINE_ROOT=./data/quarantine
FINANCE_OS_MAX_UPLOAD_BYTES=26214400
NEXT_PUBLIC_FINANCE_OS_API_URL=http://localhost:8000
